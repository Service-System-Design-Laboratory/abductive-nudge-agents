# .env.sample
# このファイルを .env にコピーして、実際の値を設定してください
# Copy this file to .env and fill in your actual values

# ============================================================
# Azure OpenAI設定 / Azure OpenAI Configuration
# ============================================================
# Azure Portal (https://portal.azure.com/) でOpenAIリソースを作成し、
# APIキーとエンドポイントを取得してください

AZURE_OPENAI_API_KEY="your_azure_openai_api_key_here"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/openai/deployments/gpt-4.1/chat/completions?api-version=2025-01-01-preview"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"
AZURE_OPENAI_DEPLOYMENT="gpt-4.1"  # デプロイ名

# ============================================================
# Neo4j設定 / Neo4j Configuration
# ============================================================
# docker-compose.ymlでNEO4J_AUTH=noneに設定されている場合、
# USERNAME/PASSWORDは任意の値で構いません
# If NEO4J_AUTH=none is set in docker-compose.yml,
# USERNAME/PASSWORD can be any value

NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password123"

# ============================================================
# Serper API設定 (オプション) / Serper API Configuration (Optional)
# ============================================================
# Google検索機能を使用する場合は https://serper.dev/ でAPIキーを取得
# Get your API key from https://serper.dev/ to enable Google search functionality
# 
# 未設定の場合、ExplorerAgentはLLMの既存知識のみを使用します
# If not set, ExplorerAgent will use LLM's existing knowledge only

SERPER_API_KEY="your_serper_api_key_here"
